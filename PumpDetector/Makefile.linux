# Linux-specific Makefile for goProPumpingParser.cpp with GPMF-parser
# Simplified version that works on Linux without libdspl-2.0 dependency

CC = g++
CFLAGS = -Wall -Wextra -O2 -DBUILD_LIB -Wno-write-strings -Wno-missing-field-initializers -Wno-unused-parameter -Wno-address
INCLUDES = -I"gpmf-parser" -I"gpmf-parser/demo" -I"implot" -I"imgui" -I"imgui/backends" -I"glfw/include" -I"libtinyfiledialogs"

# Linux OpenGL libraries
LINUX_LIBS = -lGL -ldl -lpthread

# Source files
GPMF_SOURCES = gpmf-parser/GPMF_parser.c \
               gpmf-parser/GPMF_utils.c \
               gpmf-parser/demo/GPMF_mp4reader.c

IMGUI_SOURCES = imgui/imgui.cpp \
                imgui/imgui_draw.cpp \
                imgui/imgui_tables.cpp \
                imgui/imgui_widgets.cpp \
                imgui/backends/imgui_impl_glfw.cpp \
                imgui/backends/imgui_impl_opengl3.cpp

IMPLOT_SOURCES = implot/implot.cpp \
                 implot/implot_items.cpp

TINYFILEDIALOGS_SOURCES = libtinyfiledialogs/tinyfiledialogs.c

MAIN_SOURCE = goProPumpingParser.cpp pumpDetector.cpp

SOURCES = $(MAIN_SOURCE) $(GPMF_SOURCES) $(IMGUI_SOURCES) $(IMPLOT_SOURCES) $(TINYFILEDIALOGS_SOURCES)

OBJECTS = $(SOURCES:.cpp=.o)
OBJECTS := $(OBJECTS:.c=.o)

TARGET = goProPumpingParser

# Default target
all: build-glfw $(TARGET)

# Build GLFW first
build-glfw:
	@echo "Building GLFW..."
	@if [ ! -d "glfw/build" ]; then mkdir -p glfw/build; fi
	@cd glfw/build && cmake .. -DGLFW_BUILD_EXAMPLES=OFF -DGLFW_BUILD_TESTS=OFF -DGLFW_BUILD_DOCS=OFF
	@cd glfw/build && make -j4

# Link target from object files (without libdspl for now)
$(TARGET): $(OBJECTS)
	$(CC) $(CFLAGS) $(INCLUDES) -o $@ $^ -Lglfw/build/src -lglfw $(LINUX_LIBS) -lm

# Compile C++ sources
%.o: %.cpp
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# Compile C sources
%.o: %.c
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# Clean up
clean:
	rm -f $(TARGET) $(OBJECTS)
	rm -rf glfw/build

# Install Linux dependencies (Arch Linux)
install-deps-arch:
	sudo pacman -S --needed base-devel cmake mesa libx11 libxrandr libxinerama libxcursor libxi

# Install Linux dependencies (Ubuntu/Debian)
install-deps-debian:
	sudo apt-get update
	sudo apt-get install build-essential cmake libgl1-mesa-dev libx11-dev libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev

.PHONY: all clean build-glfw install-deps-arch install-deps-debian