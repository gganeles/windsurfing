pumpDetector.i: pumpDetector.cpp.i
.PHONY : pumpDetector.i

# target to preprocess a source file
pumpDetector.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/goProPumpingParser.dir/build.make CMakeFiles/goProPumpingParser.dir/pumpDetector.cpp.i
.PHONY : pumpDetector.cpp.i

pumpDetector.s: pumpDetector.cpp.s
.PHONY : pumpDetector.s

# target to generate assembly for a file
pumpDetector.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/goProPumpingParser.dir/build.make CMakeFiles/goProPumpingParser.dir/pumpDetector.cpp.s
.PHONY : pumpDetector.cpp.s

